{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:room": "tsc --noEmit -p tsconfig.room-check.json",
    "check:entitlements": "! grep -rn \"plan === '\" src/ --exclude='entitlements-store.ts'",
    "lint": "eslint .",
    "test:rules": "vitest run tests/firestore-rules.test.ts",
    "test:unit": "vitest run --exclude tests/firestore-rules.test.ts",
    "test:e2e": "playwright test",
    "i18n:sync": "npx tsx scripts/i18n-sync.ts",
    "data:export": "npx tsx scripts/export-user-data.ts",
    "data:import": "npx tsx scripts/import-user-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.160.0",
    "eslint": "^9.39.5",
    "playwright-core": "^1.60.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.2.11",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.19.1",
    "@amcharts/amcharts5-geodata": "^5.1.5",
    "@sentry/browser": "^10.51.0",
    "d3-array": "^3.2.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "firebase": "^12.16.0",
    "html-to-image": "^1.11.13",
    "posthog-js": "^1.372.6",
    "qrcode": "^1.5.4",
    "three": "^0.160.1",
    "zod": "^4.4.2"
  }
}
