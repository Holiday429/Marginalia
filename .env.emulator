# Non-secret values for the local Firebase Emulator Suite (e2e). Used by `vite --mode emulator`.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-marginalia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-marginalia
VITE_FIREBASE_STORAGE_BUCKET=demo-marginalia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_WORKSPACE_ID=default
