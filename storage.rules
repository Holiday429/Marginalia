rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    function isSelfWorkspaceUser(workspaceId, uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isAllowedImageType() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isUnder2MB() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    // Cover images — image MIME only, ≤ 2MB, owner only.
    match /workspaces/{workspaceId}/users/{uid}/covers/{allPaths=**} {
      allow read: if isSelfWorkspaceUser(workspaceId, uid);
      allow write: if isSelfWorkspaceUser(workspaceId, uid)
                   && isAllowedImageType()
                   && isUnder2MB();
    }

    // All other user files (note attachments, etc.) — owner only, no MIME restriction.
    match /workspaces/{workspaceId}/users/{uid}/{allPaths=**} {
      allow read, write: if isSelfWorkspaceUser(workspaceId, uid);
    }

    // Deny any other storage path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
