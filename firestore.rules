rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Public profile check: user doc must exist and profilePublic must be true.
    // get() runs with rules privileges, so it works even though /users/{uid} is owner-only.
    function isPublicProfile(uid) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid));
      return userDoc != null && userDoc.data.settings.profilePublic == true;
    }

    // Fields only the server may set. Clients can never write these on /users/{uid}.
    function billingKeys() {
      return ['plan', 'entitlements', 'quota', 'billing'];
    }

    // /users/{uid} — account-level metadata (settings incl. slug/profilePublic, avatar).
    // Owner-only. Billing fields live in /billing/{uid} and can never be written from the client.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && !request.resource.data.keys().hasAny(billingKeys());
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys());
      allow delete: if false;
    }

    // /billing/{uid} — plan, status, currentPeriodEnd, … Written by the billing webhook only.
    match /billing/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // /usage/{uid}/months/{YYYY-MM} — AI usage counters. Written by Cloud Functions only.
    match /usage/{uid}/months/{month} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // /publicProfiles/{slug} — the only user data anonymous visitors can read.
    // The doc id is the slug, so Firestore itself guarantees uniqueness: only the uid that
    // created a slug can update or delete it. Exists only while the profile is public.
    match /publicProfiles/{slug} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && slug.matches('^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$|^[a-z0-9]{1,32}$')
        && !(slug in ['admin', 'api', 'app', 'auth', 'billing', 'help', 'home', 'login', 'logout',
                      'me', 'profile', 'settings', 'signup', 'support', 'terms', 'privacy',
                      'credits', 'about', 'contact', 'p', 'u'])
        && request.resource.data.keys().hasOnly(['uid', 'slug', 'displayName', 'avatarUrl', 'bio',
                                                 'location', 'joinedAt', 'sections', 'updatedAt']);
      allow update: if isAuthed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'slug', 'displayName', 'avatarUrl', 'bio',
                                                 'location', 'joinedAt', 'sections', 'updatedAt']);
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }

    // /workspaces/{workspaceId}/userProfiles/{uid}
    match /workspaces/{workspaceId}/userProfiles/{uid} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/graph/linkStatus
    match /workspaces/{workspaceId}/users/{uid}/graph/{docId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/books/{bookId}
    // Read: self always; public if profilePublic AND book.shareInProfile.
    match /workspaces/{workspaceId}/users/{uid}/books/{bookId} {
      allow read: if isSelf(uid)
        || (isPublicProfile(uid) && resource.data.shareInProfile == true);
      allow write: if isSelf(uid);
    }

    // Everything below a book: notes/main, ai/{featureId}, visualNotes/{id}. Owner only.
    match /workspaces/{workspaceId}/users/{uid}/books/{bookId}/{sub=**} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/ai_results/{featureId} — profile-level AI output (reader portrait, …)
    match /workspaces/{workspaceId}/users/{uid}/ai_results/{featureId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/annual_shelf/{year} — Top-10 of the year
    match /workspaces/{workspaceId}/users/{uid}/annual_shelf/{year} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/data/{docId} — library_layout (shelf arrangement)
    match /workspaces/{workspaceId}/users/{uid}/data/{docId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/highlights/{highlightId}
    match /workspaces/{workspaceId}/users/{uid}/highlights/{highlightId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/moments/{bookId} — finish ritual record (answers + finish card).
    // Owner only; the doc id is the book id, so there is at most one per book.
    match /workspaces/{workspaceId}/users/{uid}/moments/{bookId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/sessions/{sessionId} — reading-session timer records.
    // Owner only. A session must carry a numeric startedAt and it can never be rewritten.
    match /workspaces/{workspaceId}/users/{uid}/sessions/{sessionId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.startedAt is number
        && request.resource.data.bookId is string;
      allow update: if isSelf(uid)
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/users/{uid}/actions/{actionId}
    match /workspaces/{workspaceId}/users/{uid}/actions/{actionId} {
      allow read, write: if isSelf(uid);
    }

    // /workspaces/{workspaceId}/notifications/{uid}/unread/{docId}
    // Write: Cloud Function only (Admin SDK bypasses rules).
    // Read + update (mark read): owner only.
    match /workspaces/{workspaceId}/notifications/{uid}/unread/{docId} {
      allow read, write: if isSelf(uid);
    }

    // /audit/ai_calls/{uid}/{timestamp}
    // Write: Cloud Function only (Admin SDK bypasses rules — client write denied).
    // Read: owner only (for future audit log UI).
    match /audit/ai_calls/{uid}/{docId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Block everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
